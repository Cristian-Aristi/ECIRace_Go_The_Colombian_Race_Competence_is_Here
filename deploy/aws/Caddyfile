# Proxy inverso de ECIRace GO en AWS.
# - HTTPS automático con Let's Encrypt para {$DOMAIN} (<ip>.sslip.io): el GPS del navegador
#   solo funciona en un contexto seguro.
# - Los WebSockets (/race-ws-native, /race-ws) pasan sin configuración extra.
# - Solo se expone lo que el juego necesita; Actuator queda cerrado salvo salud y métricas.
{
	admin off
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
		# La Content-Security-Policy la envía la aplicación (SecurityHeadersFilter)
	}

	# Rutas con ";" (parámetros de ruta): Tomcat los ignora y Caddy no, así que "/actuator;x/prometheus"
	# podría esquivar las reglas de abajo. El juego nunca las usa: se rechazan.
	@pathparams path_regexp pp ;
	handle @pathparams {
		respond 400
	}

	# Salud: la usan scripts/aws.py y la sonda de disponibilidad.
	# Actuator vive en el puerto 8081 (perfil cloud), que solo alcanza Caddy por la red interna.
	@health path /actuator/health /actuator/health/*
	handle @health {
		reverse_proxy app:8081
	}

	# Métricas para Prometheus: protegidas con usuario y contraseña (bcrypt)
	@metrics path /actuator/prometheus
	handle @metrics {
		import /etc/caddy/metrics_auth.caddy
		reverse_proxy app:8081
	}

	# Todo lo administrativo queda fuera de internet (además, en 8080 ya no existe /actuator)
	@private path /actuator /actuator/* /admin /admin/* /h2-console /h2-console/*
	handle @private {
		respond 404
	}

	handle {
		reverse_proxy app:8080
	}

	log {
		output stdout
		format console
	}
}
